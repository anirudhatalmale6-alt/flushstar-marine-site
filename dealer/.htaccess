# _boot.php is an include, never a page. PHP's own require still works; this
# only stops it being fetched directly over HTTP.
<FilesMatch "^_boot\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
